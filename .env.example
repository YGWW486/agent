# LLM Provider: anthropic | deepseek
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# DeepSeek V4 (2026-04-23 发布, openai>=1.30.0)
# 模型: deepseek-v4-pro (1.6T/49B, 1M ctx) | deepseek-v4-flash (284B/13B, 1M ctx)
# 旧 ID deepseek-chat/reasoner 将于 2026-07-24 下线
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=1.0
# thinking_mode: non-thinking | thinking | thinking_max
DEEPSEEK_THINKING_MODE=thinking

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-qa
LANGSMITH_TRACING=false

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Queue
QUEUE_MAXSIZE=50

# Timeout
DEFAULT_TIMEOUT_MS=5000

# Workflow
MAX_REVISIONS=3
WORKFLOW_TIMEOUT=300

# Cost
DAILY_TOKEN_BUDGET=1000000
TASK_TOKEN_LIMIT=100000
