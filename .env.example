# LLM Provider: anthropic | deepseek
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# DeepSeek V4 (2026-04-23 发布, openai>=1.30.0)
# 模型: deepseek-v4-pro (1.6T/49B, 1M ctx) | deepseek-v4-flash (284B/13B, 1M ctx)
# 旧 ID deepseek-chat/reasoner 将于 2026-07-24 下线
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=1.0
# thinking_mode: non-thinking | thinking | thinking_max
DEEPSEEK_THINKING_MODE=thinking

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-qa
LANGSMITH_TRACING=false

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Queue
QUEUE_MAXSIZE=50

# Timeout
DEFAULT_TIMEOUT_MS=5000

# Workflow (MAX_REVISIONS: 0 = unlimited reviewer reject cycles)
MAX_REVISIONS=0
WORKFLOW_TIMEOUT=300

# Cost
DAILY_TOKEN_BUDGET=1000000
TASK_TOKEN_LIMIT=100000

# Context (GraphIndex prompt assembly)
PLANNER_CONTEXT_MAX_FILES=30
CODER_CONTEXT_DEPTH=2
CODER_CONTEXT_MAX_FILES=15
CONTEXT_MAX_CHARS=24000

# Phase 4: Coder read-only tools (read_file, list_dir, search_repo)
CODER_TOOLS_ENABLED=false
CODER_TOOL_MAX_ROUNDS=5
WORKSPACE_ROOT=
READ_FILE_MAX_BYTES=65536
SEARCH_RG_MAX_RESULTS=50
SEARCH_RG_TIMEOUT_SEC=5
